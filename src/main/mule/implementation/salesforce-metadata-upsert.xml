<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:salesforce="http://www.mulesoft.org/schema/mule/salesforce" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/salesforce http://www.mulesoft.org/schema/mule/salesforce/current/mule-salesforce.xsd">
	<sub-flow name="salesforce-metadata-upsert-sub-flow" doc:id="b32e5fd6-e43e-4c69-b8be-f2fdbbbc7e61" >
		<logger level="INFO" doc:name="Start" doc:id="6685961f-cb41-4d5d-b612-463839bb8d7f" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;	flow: "Start of flow : " ++ flow.name,&#10;	message: "Salesforce Metadata Upsert Sub Flow Started",&#10;	correlationId: vars.correlationId,&#10;	piSyncObject: vars.piSyncObject&#10;}]' />
		<ee:transform doc:name="Filter name == null" doc:id="1ea8ecf0-183f-472d-a752-2d73c870a0a3" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
payload filter (!isEmpty($.Name))]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<parallel-foreach doc:name="Parallel Iteration on Records" doc:id="3a7aab1f-9dbd-4435-b12f-ec39eab824a0" collection="#[payload]">
			<ee:transform doc:name="var: record" doc:id="df09f3ca-f774-4040-8894-a1e8dea9fb86" >
				<ee:message />
				<ee:variables >
					<ee:set-variable variableName="record" ><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
			<ee:transform doc:name="var: recordId" doc:id="37780ca9-819b-471a-8687-ce694ea745ef" >
				<ee:message />
				<ee:variables >
					<ee:set-variable variableName="recordId" ><![CDATA[%dw 2.0
output application/json
---
"X" ++ vars.record.Id replace "-" with "_"]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
			<ee:transform doc:name="var: sfMetadataObject" doc:id="c357a7b7-09df-4e63-8fd2-ff984a769ad7" >
				<ee:message >
				</ee:message>
				<ee:variables >
					<ee:set-variable variableName="sfMetadataObject" ><![CDATA[output json
---
if ( vars.piSyncObject == "Department" ) ["Project_Department__mdt.$(vars.recordId)"]
else if ( vars.piSyncObject == "ProjectStatus" ) ["Project_Status__mdt.$(vars.recordId)"]
else if ( vars.piSyncObject == "ProjectType" ) ["Project_Type__mdt.$(vars.recordId)"]
else ["Resource_Type__mdt.$(vars.recordId)"]]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
			<salesforce:read-metadata type="CustomMetadata" doc:name="Read metadata" doc:id="d7ef9818-7a76-4d24-9de5-e614b08e94e1" config-ref="salesforce-configuration" >
				<reconnect frequency="${reconnection.frequency}" count="${reconnection.attempts}"/>
				<salesforce:full-names ><![CDATA[#[vars.sfMetadataObject]]]></salesforce:full-names>
			</salesforce:read-metadata>
			<ee:transform doc:name="Payload Transformation" doc:id="b4f835c5-8e5e-4be6-9a1e-bd0affedc818" >
				<ee:message >
					<ee:set-payload resource="dwl/p-sfMetadataMapping.dwl" />
				</ee:message>
			</ee:transform>
			<logger level="DEBUG" doc:name="Debug:  Payload" doc:id="0eb967cf-37d4-49b0-87d3-9d017c0aaaa2" message="#[output json --- payload]" category="${debugPackages.sf}"/>
			<salesforce:upsert-metadata type="CustomMetadata" doc:name="Upsert metadata" doc:id="12a42992-113b-4b51-b30e-3e0375d161aa" config-ref="salesforce-configuration" >
				<reconnect count="${reconnection.attempts}" frequency="${reconnection.frequency}"/>
			</salesforce:upsert-metadata>
			<logger level="DEBUG" doc:name="Debug : Upsert Metadata Output" doc:id="9a35cb91-eb4c-4c66-9805-c008655b3afa" message="#[output json --- payload]" category="${debugPackages.sf}"/>
		</parallel-foreach>
		<ee:transform doc:name="Final Payload" doc:id="05c4cc20-b1ec-412c-a3df-a17d8af12b6b" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	message: "The $(vars.piSyncObject) records are synced from Project Insights to Salesforce Metadata Object."
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="End" doc:id="3b7215d8-8049-4d04-87de-56a31a2771f8" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;	flow: "End of flow : " ++ flow.name,&#10;	message: "Salesforce Metadata Upsert Sub Flow Ended",&#10;	correlationId: vars.correlationId&#10;}]' />
	</sub-flow>
</mule>
